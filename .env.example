# Core security secrets - generate strong random values and keep ENCRYPTION_MASTER_KEY permanent.
ENCRYPTION_MASTER_KEY="replace_with_a_long_random_secret_32bytes_or_more"
SESSION_SECRET="replace_with_a_long_random_secret"
GATEWAY_SIGNING_SECRET="replace_with_a_long_random_secret"
BROWSER_AGENT_SHARED_SECRET="replace_with_a_long_random_secret"

# Owner login - 12+ chars, unique, never reused.
OWNER_PASSWORD="replace-with-a-strong-owner-password"

# App/runtime metadata
APP_URL="http://localhost:3000"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
DB_POOL_MAX="10"
NODE_ENV="development"

