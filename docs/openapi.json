{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Control Center Gateway",
    "version": "1.1.0",
    "description": "Capability-scoped bridge for authorized external AI agents. Secrets are never returned."
  },
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "GatewayKey"
      }
    },
    "schemas": {
      "GatewayError": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "operationId": {
            "type": "string"
          }
        }
      },
      "SafeResult": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "paths": {
    "/handshake": {
      "post": {
        "summary": "Accept the first-use access manifest.",
        "responses": {
          "200": {
            "description": "Handshake accepted"
          },
          "400": {
            "description": "Invalid request or blocked operation"
          },
          "401": {
            "description": "Gateway authentication required"
          },
          "403": {
            "description": "Capability denied"
          },
          "428": {
            "description": "First-use handshake required"
          }
        }
      }
    },
    "/capabilities": {
      "get": {
        "summary": "Read the current safe capability manifest.",
        "responses": {
          "200": {
            "description": "Safe access manifest"
          },
          "400": {
            "description": "Invalid request or blocked operation"
          },
          "401": {
            "description": "Gateway authentication required"
          },
          "403": {
            "description": "Capability denied"
          },
          "428": {
            "description": "First-use handshake required"
          }
        }
      }
    },
